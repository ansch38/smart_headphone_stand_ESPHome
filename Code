# Board: Wemos D1 Mini (ESP8266) (Wemos)
# Definition: definitions/boards/d1_mini/manifest.yaml

esphome:
  name: esp_smart-headphone-stand
  friendly_name: ESP_smart_headphone_stand

esp8266:
  board: d1_mini

logger:

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

captive_portal:

binary_sensor:
  - platform: gpio
    name: "Smart_Headphone_Microswitch"
    id: smart_headphone_microswitch
    pin:
      number: GPIO12
      mode:
        input: true
        pullup: true
      inverted: false
    filters:
      - delayed_on: 50ms
      - delayed_off: 50ms
